# Copy to .env only if you need to override defaults. Nothing here is required for `docker compose up`,
# and real secrets never belong in a file in this repository (use env vars, user-secrets or a vault).
# Azure AD (staging/production):
#   AzureAd__TenantId=<your tenant id>
#   AzureAd__ClientId=<your api app registration client id>
# Optional narration provider (off by default; the product is fully functional without any model):
#   Ai__LlmNarration=false
# Pin "today" for demos so seed-relative dates (expiring delegation, arrear ages) stay meaningful:
#   Rosterix__FixedToday=2026-10-10
