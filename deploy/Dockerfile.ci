# CI image for the E2E stage: .NET 8 SDK + Node 22 + Playwright's Chromium and its OS dependencies.
FROM mcr.microsoft.com/playwright:v1.47.0-jammy
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
 && wget -q https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb && dpkg -i packages-microsoft-prod.deb \
 && apt-get update && apt-get install -y --no-install-recommends dotnet-sdk-8.0 && rm -rf /var/lib/apt/lists/*
