# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /web
COPY src/Rosterix.Web/package.json src/Rosterix.Web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/Rosterix.Web/ ./
RUN npx ng build --configuration production

FROM nginxinc/nginx-unprivileged:1.27-alpine AS final
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /web/dist/rosterix-web/ /usr/share/nginx/html/
ENV API_UPSTREAM=http://api:8080
EXPOSE 8080
# SEC-09: non-root (the unprivileged nginx image runs as uid 101 / `nginx`).
USER nginx
